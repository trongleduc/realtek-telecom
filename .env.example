# Demo mode: the public site runs from src/demo/content.ts with no database (admin and API disabled).
# Automatically on when DATABASE_URI is empty; set DEMO_MODE=1 to force it.
DEMO_MODE=

# MongoDB connection string
DATABASE_URI=mongodb://127.0.0.1:27017/realtek-telecom
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Primary domain (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://realtektelecom.com
# Hosts redirected (301) to the primary domain
ALTERNATE_HOSTS=rtit.asia,www.rtit.asia,www.realtektelecom.com

# Cloudflare R2 (media). Leave R2_BUCKET empty to store uploads on local disk in development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL or custom domain, e.g. https://media.realtektelecom.com
R2_PUBLIC_URL=
# Separate bucket for database backups (scripts/backup.ts)
R2_BACKUP_BUCKET=

# SMTP for contact-form notifications. Without SMTP_HOST, emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@realtektelecom.com

# Cloudflare Turnstile (contact form). Optional in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
